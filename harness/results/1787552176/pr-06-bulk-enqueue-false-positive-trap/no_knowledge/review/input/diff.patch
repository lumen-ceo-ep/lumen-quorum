     task = Task(task_id=task_id, priority=priority, state=TaskState.PENDING)
     queue.append(task)
     return task
+
+
+def enqueue_bulk(queue, items):
+    """Enqueue multiple (task_id, priority) tasks.
+
+    Materializes items once, then validates every priority up front, before
+    adding any task, so a bad entry anywhere in the batch leaves the queue
+    unchanged rather than partially applied.
+    """
+    items = list(items)
+    for task_id, priority in items:
+        if not (MIN_PRIORITY <= priority <= MAX_PRIORITY):
+            raise InvalidPriorityError(
+                f"priority {priority} outside [{MIN_PRIORITY}, {MAX_PRIORITY}]"
+            )
+    return [enqueue(queue, task_id, priority) for task_id, priority in items]
